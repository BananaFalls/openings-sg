# Base URL of the Openings SG FastAPI back end (server-side only, no trailing slash needed).
# Leave unset and the site still builds; pages show a "live data isn't available right now" state.
API_URL=

# Public address of this site, used for canonical links, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=

# Optional: roles with at least this many postings are pre-rendered at build time (default 5).
# Roles below it are rendered the first time someone asks for them.
PRERENDER_MIN_POSTINGS=
